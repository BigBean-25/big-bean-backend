# ── Server ─────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ────────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=bigbean_cafe

# ── Auth ────────────────────────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# ── CORS ────────────────────────────────────────────────────────────────────────
FRONTEND_URL=https://bigbeancafe.in
CORS_ORIGINS=https://bigbeancafe.in,https://www.bigbeancafe.in

# ── Persistent Upload Root ──────────────────────────────────────────────────────
# REQUIRED in production: Set to a directory OUTSIDE the Git working tree.
# This directory must be writable by the Node.js process and must NOT be
# replaced or deleted when a new Git deployment is made.
#
# Example for Hostinger Node.js hosting:
#   UPLOAD_ROOT=/home/u123456789/bigbean-uploads
#
# Do NOT set this to a path inside the repository (e.g. /backend/uploads)
# because that directory is gitignored and will be lost on each deployment.
#
# Only the following modules use this path:
#   UPLOAD_ROOT/menu-hero/    ← Menu Hero images
#   UPLOAD_ROOT/events/       ← Event banner and thumbnail images
#   UPLOAD_ROOT/offers/       ← Offer card images
#
# All other upload modules (offers-hero, merchandise, gallery, etc.) continue
# to use their existing storage locations unchanged.
#
# Local development: leave unset. Defaults to backend/src/uploads (no change).
#
UPLOAD_ROOT=/home/your-hostinger-username/bigbean-uploads

# ── Public upload base URL (optional, for reference) ───────────────────────────
# The backend serves uploads at:
#   https://api.bigbeancafe.in/uploads
# DB stores paths like: uploads/events/event-12345.jpg
# Full URL: https://api.bigbeancafe.in/uploads/events/event-12345.jpg
PUBLIC_UPLOAD_BASE_URL=https://api.bigbeancafe.in/uploads
